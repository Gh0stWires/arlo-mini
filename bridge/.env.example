# Listen on the LAN so the K10 can access the bridge.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765
# Set a long, random value; copy same value to firmware/include/secrets.h.
DEVICE_KEY=replace-with-a-long-random-device-secret
# Hermes gateway remains bound to 127.0.0.1 on this computer.
HERMES_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_KEY=replace-with-your-hermes-api-key
HERMES_MODEL=hermes-agent
HERMES_MAX_TOKENS=96
# Optional Hermes Bot soul layered onto the spoken system prompt.
HERMES_SOUL_FILE=
STT_MODEL=base.en
STT_DEVICE=auto
STT_COMPUTE_TYPE=default
# Optional: absolute Python path for a separate STT worker. Required when
# Chatterbox runs in its CUDA environment on Windows.
STT_WORKER_PYTHON=
# auto = Windows SAPI via PowerShell or espeak-ng on Linux.
# Optional: piper CLI (requires installed piper model and binary).
# chatterbox = Chatterbox Turbo using the selected reference recording.
TTS_BACKEND=auto
PIPER_BINARY=piper
PIPER_MODEL=
# Required when TTS_BACKEND=chatterbox. Set this to a clean reference WAV.
CHATTERBOX_REFERENCE=
CHATTERBOX_DEVICE=auto
CHATTERBOX_MAX_GEN_LEN=600
# Keep the model and reference conditioning warm at bridge startup.
CHATTERBOX_PRELOAD=true
# Optional experiment: use the smaller reference-cloning Nano model.
# Leave false to keep the validated Turbo voice path.
CHATTERBOX_NANO=false
# Optional experiment: use the isolated CUDA chatterbox.cpp runtime.
# Keep TTS_BACKEND=chatterbox for the validated Python Turbo fallback.
# chatterbox_cpp runs one native process per complete answer in batch mode.
CHATTERBOX_CPP_BINARY=
CHATTERBOX_CPP_MODEL=
CHATTERBOX_CPP_S3GEN=
CHATTERBOX_CPP_PROFILE=
# Semicolon-separated on Windows. Include ggml-cuda.dll and CUDA runtime dirs.
CHATTERBOX_CPP_RUNTIME_PATHS=
CHATTERBOX_CPP_THREADS=4
CHATTERBOX_CPP_GPU_LAYERS=99
CHATTERBOX_CPP_N_PREDICT=600
CHATTERBOX_CPP_SEED=42
CHATTERBOX_CPP_TIMEOUT=300
CHATTERBOX_CPP_VERBOSE=true
CHATTERBOX_CPP_BATCH=true
# Experimental true PCM mode: native raw PCM -> bridge HTTP stream -> K10 I2S.
# Keep false to use the validated complete-WAV/SD fallback.
CHATTERBOX_CPP_LIVE_STREAM=false
CHATTERBOX_CPP_MAX_SENTENCE_CHARS=180
# Native S3Gen chunking prevents long generated speech sequences from crashing
# the CUDA CLI. Set to 0 only for isolated single-shot experiments.
CHATTERBOX_CPP_STREAM_CHUNK_TOKENS=50
CHATTERBOX_CPP_STREAM_FIRST_CHUNK_TOKENS=50
# Experimental: emit short clause-sized audio segments before full sentences
# finish. Keep false for the validated sentence-streaming behavior.
CHATTERBOX_PHRASE_STREAMING=false
CHATTERBOX_MIN_PHRASE_WORDS=5
CHATTERBOX_MAX_PHRASE_WORDS=10
# If Piper isn't configured, auto uses platform-native TTS.
# For first test without Hermes, set MOCK_HERMES=true.
MOCK_HERMES=false
